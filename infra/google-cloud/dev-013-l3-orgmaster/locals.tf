locals {
  service_name        = "orgmaster-stg"
  artifact_repository = "dev013-orgmaster-staging"
  evidence_bucket     = "jenfu-platform-nonprod-dev013-orgmaster-evidence"
  evidence_prefix     = "receipts/dev-013/l3/orgmaster"
  runtime_account     = "dev010-stg-orgmaster-runtime"
  iac_account         = "dev010-n1b-iac"
  qc_account          = "dev010-n1c-qc"
  runtime_secret      = "dev010-stg-orgmaster-runtime-config"
  network             = "jenfu-platform-nonprod-vpc"
  subnetwork          = "jenfu-platform-nonprod-qc"
  cloud_sql_instance  = "jenfu-platform-nonprod-pg"
  database            = "jenfu_stg"
  orgmaster_origin    = "https://${local.service_name}-${data.google_project.target.number}.${var.region}.run.app"
  platform_origin     = "https://jenfu-platform-stg-${data.google_project.target.number}.${var.region}.run.app"
  labels = {
    application = "orgmaster"
    dev_id      = "dev-013"
    environment = "staging"
    managed_by  = "terraform"
    owner       = "orgmaster"
    slice       = "013-s4-l3"
  }
  runtime_environment = {
    NODE_ENV                                 = "production"
    JENFU_RUNTIME_ENVIRONMENT                = "production"
    ORGMASTER_PERSISTENCE_MODE               = "cloud-sql"
    ORGMASTER_PUBLIC_BASE_URL                = local.orgmaster_origin
    ORGMASTER_POSTGRES_URL                   = "postgresql://dev010-stg-orgmaster-runtime%40jenfu-platform-nonprod.iam@127.0.0.1:5432/${local.database}"
    ORGMASTER_POSTGRES_POOL_MAX              = "2"
    ORGMASTER_POSTGRES_CONNECTION_TIMEOUT_MS = "5000"
    ORGMASTER_POSTGRES_IDLE_TIMEOUT_MS       = "30000"
    ORGMASTER_POSTGRES_STATEMENT_TIMEOUT_MS  = "30000"
    ORGMASTER_POSTGRES_QUERY_TIMEOUT_MS      = "35000"
    JENFU_FIREBASE_PROJECT_ID                = var.project_id
    JENFU_IDENTITY_ISSUER                    = "https://securetoken.google.com/${var.project_id}"
    JENFU_IDENTITY_AUDIENCE                  = var.project_id
    VITE_JENFU_FIREBASE_API_KEY              = var.firebase_public_api_key
    VITE_JENFU_FIREBASE_AUTH_DOMAIN          = "${var.project_id}.firebaseapp.com"
    VITE_JENFU_FIREBASE_PROJECT_ID           = var.project_id
    VITE_JENFU_FIREBASE_APP_ID               = var.firebase_public_app_id
    ORGMASTER_JENFU_SSO_HANDOFF_MODE         = "off"
    ORGMASTER_JENFU_SSO_BROKER_ORIGIN        = local.platform_origin
    DEV013_L3_SOURCE_REVISION                = var.source_revision
    DEV013_L3_SOURCE_TREE                    = var.source_tree
    DEV013_L3_PLATFORM_MANIFEST_SHA256       = var.platform_manifest_sha256
    DEV013_L3_CANONICAL_CONTRACT_SHA256      = var.canonical_contract_sha256
    DEV013_L3_FOUNDATION_MANIFEST_SHA256     = var.foundation_manifest_sha256
    DEV013_L3_FIREBASE_PUBLIC_CONFIG_SHA256  = var.firebase_public_config_sha256
  }
}
