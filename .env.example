# DEV-032 local AI draft generation (leave blank to use the explicit local fake-AI header only)
OPENAI_API_KEY=
ORGMASTER_MANAGEMENT_METHOD_MODEL=
# DEV-037 employee recommendations: uses saved organization positions/duties.
# Blank reuses ORGMASTER_MANAGEMENT_METHOD_MODEL; no configured provider uses labelled rules.
ORGMASTER_EMPLOYEE_RECOMMENDATION_MODEL=

# DEV-004 shared identity / OrgMaster app-local session.
# Use the exact bare origin from the active release profile: no path, query, fragment, credentials, or trailing slash.
ORGMASTER_PUBLIC_BASE_URL=http://localhost:1010
ORGMASTER_POSTGRES_URL=
ORGMASTER_SESSION_HASH_PEPPER=
JENFU_FIREBASE_PROJECT_ID=
JENFU_IDENTITY_ISSUER=
JENFU_IDENTITY_AUDIENCE=
VITE_JENFU_FIREBASE_API_KEY=
VITE_JENFU_FIREBASE_AUTH_DOMAIN=
VITE_JENFU_FIREBASE_PROJECT_ID=
VITE_JENFU_FIREBASE_APP_ID=

# DEV-060 non-production local SSO uses the exact localhost:1010 / localhost:1000 origin pair.
ORGMASTER_JENFU_SSO_HANDOFF_MODE=on
ORGMASTER_JENFU_SSO_BROKER_ORIGIN=http://localhost:1000
# Local service-token acquisition uses ADC impersonation; never download or configure a service-account key.
# Fill this only with the separately authorized OrgMaster non-production service account.
JENFU_SSO_IMPERSONATE_SERVICE_ACCOUNT=

# DEV-049 / DEV-014 managed identity. All five keys are required; no legacy aliases are accepted.
# Production uses IAM Credentials signJwt and never a service-account key file or Secret.
ORGMASTER_MANAGED_IDENTITY_ENABLED=false
ORGMASTER_GOOGLE_DIRECTORY_CUSTOMER_ID=
ORGMASTER_GOOGLE_DIRECTORY_DOMAIN=
ORGMASTER_GOOGLE_DIRECTORY_DELEGATED_SUBJECT=
ORGMASTER_GOOGLE_DIRECTORY_DWD_SERVICE_ACCOUNT_EMAIL=

# Exact Platform service caller accepted by the internal managed-login owner API.
ORGMASTER_PLATFORM_LOGIN_CALLER_EMAIL=
ORGMASTER_PLATFORM_LOGIN_CALLER_SUBJECT=

# DEV-006 migration CLI only; production activation remains release-gated.
ORGMASTER_DEV006_DATABASE_URL=
DEV006_TARGET_CLASS=

# DEV-006 runtime repository. local-json remains the safe default; cloud-sql requires an activated batch.
ORGMASTER_PERSISTENCE_MODE=local-json

# Production Node BFF listener; dev:local remains the Vite API-plugin server on localhost:1010.
ORGMASTER_HOST=0.0.0.0
PORT=8080
