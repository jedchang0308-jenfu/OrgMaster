# DEV-032 local AI draft generation (leave blank to use the explicit local fake-AI header only)
OPENAI_API_KEY=
ORGMASTER_MANAGEMENT_METHOD_MODEL=

# DEV-004 shared identity / OrgMaster app-local session
ORGMASTER_PUBLIC_BASE_URL=http://localhost:5000
ORGMASTER_POSTGRES_URL=
ORGMASTER_SESSION_HASH_PEPPER=
JENFU_FIREBASE_PROJECT_ID=
JENFU_IDENTITY_ISSUER=
JENFU_IDENTITY_AUDIENCE=
VITE_JENFU_FIREBASE_API_KEY=
VITE_JENFU_FIREBASE_AUTH_DOMAIN=
VITE_JENFU_FIREBASE_PROJECT_ID=
VITE_JENFU_FIREBASE_APP_ID=

# DEV-006 migration CLI only; production activation remains release-gated.
ORGMASTER_DEV006_DATABASE_URL=
DEV006_TARGET_CLASS=

# DEV-006 runtime repository. local-json remains the safe default; cloud-sql requires an activated batch.
ORGMASTER_PERSISTENCE_MODE=local-json

# Production Node BFF listener; dev:local remains Vite on localhost:5000.
ORGMASTER_HOST=0.0.0.0
PORT=8080
