          "maxLength": 255
        },
        "employeeId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 255
        },
        "issuer": {
          "type": "string",
          "minLength": 1,
          "maxLength": 255
        },
        "subject": {
          "type": "string",
          "minLength": 1,
          "maxLength": 255
        },
        "authenticatedAt": {
          "type": "string",
          "format": "date-time"
        }
      }
    }
