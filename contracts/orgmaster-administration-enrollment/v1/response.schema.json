{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "oneOf": [
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "contractVersion",
        "requestId",
        "status"
      ],
      "properties": {
        "contractVersion": {
          "const": "orgmaster.administration-enrollment.v1"
        },
        "requestId": {
          "type": "string",
          "format": "uuid"
        },
        "status": {
          "const": "not_applicable"
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "contractVersion",
        "requestId",
        "status",
        "commandId",
        "principalId",
        "employeeId",
        "issuer",
        "subject",
        "authenticatedAt"
      ],
      "properties": {
