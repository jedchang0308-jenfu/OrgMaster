          "const": "orgmaster.administration-enrollment.v1"
        },
        "requestId": {
          "type": "string",
          "format": "uuid"
        },
        "status": {
          "const": "activation_pending"
        },
        "commandId": {
          "type": "string",
          "format": "uuid"
        },
        "principalId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 255
        },
        "employeeId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 255
        },
        "issuer": {
          "type": "string",
          "minLength": 1,
          "maxLength": 255
        },
        "subject": {
          "type": "string",
          "minLength": 1,
          "maxLength": 255
        },
        "authenticatedAt": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "contractVersion",
        "requestId",
        "status",
        "commandId",
        "principalId",
        "employeeId",
        "issuer",
        "subject",
        "authenticatedAt"
      ],
      "properties": {
        "contractVersion": {
          "const": "orgmaster.administration-enrollment.v1"
        },
        "requestId": {
          "type": "string",
          "format": "uuid"
        },
        "status": {
          "const": "completed"
        },
        "commandId": {
          "type": "string",
          "format": "uuid"
        },
