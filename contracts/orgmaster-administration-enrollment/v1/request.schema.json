{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contractVersion",
    "requestId",
    "directoryCustomerId",
    "idToken"
  ],
  "properties": {
    "contractVersion": {
      "const": "orgmaster.administration-enrollment.v1"
    },
    "requestId": {
      "type": "string",
      "format": "uuid"
    },
    "directoryCustomerId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 255
    },
    "idToken": {
      "type": "string",
      "minLength": 1,
      "maxLength": 16384
    }
  }
}
